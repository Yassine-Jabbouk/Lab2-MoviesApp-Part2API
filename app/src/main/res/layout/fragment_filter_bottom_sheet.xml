<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="Filter Movies"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="20dp" />

    <!-- Sort By -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="SORT BY"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#E50914"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="24dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPopularity"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Popularity"
            android:checked="true"
            app:chipBackgroundColor="@color/white"
            app:checkedIconTint="#E50914"
            app:chipStrokeColor="#E50914"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRating"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Top Rated"
            app:chipBackgroundColor="@color/white"
            app:checkedIconTint="#E50914"
            app:chipStrokeColor="#E50914"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipNewest"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🆕 Newest"
            app:chipBackgroundColor="@color/white"
            app:checkedIconTint="#E50914"
            app:chipStrokeColor="#E50914"
            app:chipStrokeWidth="1dp" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Genre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="GENRE"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#E50914"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        android:layout_marginBottom="24dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGenreAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAction"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💥 Action"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComedy"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😂 Comedy"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDrama"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎭 Drama"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHorror"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👻 Horror"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSciFi"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Sci-Fi"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRomance"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ Romance"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThriller"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔪 Thriller"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAnimation"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Animation"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDocumentary"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎥 Documentary"
                app:chipBackgroundColor="@color/white"
                app:checkedIconTint="#E50914"
                app:chipStrokeColor="#E50914"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Min Rating -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="MINIMUM RATING"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#E50914"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <SeekBar
            android:id="@+id/seekBarRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="10"
            android:progress="0"
            android:progressTint="#E50914"
            android:thumbTint="#E50914" />

        <TextView
            android:id="@+id/tvRatingValue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="Any"
            android:textColor="#212121"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Reset"
            android:textColor="#E50914"
            app:strokeColor="#E50914" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#E50914"
            android:text="Apply"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>